# Salin file ini ke .env.dev / .env.uat / .env.prod lalu isi sesuai environment.
# File .env.* TIDAK di-commit (sudah masuk .gitignore).

# ----- Target URL -----
# Default: https://www.saucedemo.com (sudah diset di config/env.js)
BASE_URL=https://www.saucedemo.com

# ----- Kredensial default -----
# SauceDemo punya beberapa user publik:
#   standard_user   — user normal, semua fitur berfungsi
#   locked_out_user — diblokir, login ditolak
#   problem_user    — gambar produk salah
#   visual_user     — layout bermasalah
#   error_user      — error saat checkout
USERNAME=standard_user
PASSWORD=secret_sauce

# ----- Tampilan browser -----
HEADLESS=true
SLOWMO=0

# ----- Bukti test -----
VIDEO_ON_FAIL=1

# ----- Timeout (ms) -----
TIMEOUT_ACTION=15000
TIMEOUT_NAVIGATION=30000
TIMEOUT_EXPECT=10000
TIMEOUT_TEST=120000

# ----- BrowserStack (opsional) -----
# Uncomment dan isi untuk menjalankan di cloud browser.
# Dapatkan kredensial di: https://automate.browserstack.com/
# Untuk CI: simpan di GitHub Secrets, JANGAN di file ini.
# BROWSERSTACK_USERNAME=your_username
# BROWSERSTACK_ACCESS_KEY=your_access_key
# BROWSERSTACK_BUILD_NAME=automation-bdd-template
# BROWSERSTACK_PROJECT_NAME=SauceDemo E2E
